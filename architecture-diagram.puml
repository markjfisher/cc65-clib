@startuml BBC Micro C Library Architecture
!theme plain

title BBC Micro C Library Architecture — ROM-based cc65 Implementation

package "cc65-clib Project" as clib_project {
    folder "Source Files" as clib_src {
        component "src/libsrc/" as clib_libsrc
        note right of clib_libsrc
            bbc/       - BBC-specific functions (copied from cc65)
            common/    - Standard C library
            runtime/   - Low-level runtime (multiply, divide, etc.)
        end note
    }

    folder "Build Process" as clib_process {
        component "clib_imports.py" as manifest_generator
        note right of manifest_generator
            Analyses .info files per object:
            CODE/RODATA → ROM
            BSS/DATA etc → local (in application)
        end note
    }

    folder "Build Output" as clib_build {
        artifact "clib.rom" as rom_file
        note right of rom_file
            16 KB Sideways ROM ($8000-$BFFF)
            Jump table at $8100 (1024 × 3-byte slots)
            ~522 functions: string, math, mem, ctype, etc.
        end note

        artifact "clib_stubs.s" as clib_stubs_generated
        note right of clib_stubs_generated
            Generated stub file:
            _strlen := $999C
            _abs   := $93DE
            etc.  Each points to a fixed
            jump-table slot, not the function
            body directly (ABI stability).
        end note

        artifact "inc_objs.mk" as inc_objs
        note right of inc_objs
            Makefile fragment listing objects
            cc65 must build locally (non-ROM).
        end note
    }

    clib_libsrc --> clib_process : "ca65/cc65 → od65"
    clib_process --> clib_build
}

package "cc65 Project" as cc65_project {
    folder "bbc-clib Target" as bbc_clib_src {
        component "cc65/libsrc/bbc-clib/" as bbc_clib_libsrc
    }

    artifact "bbc-clib.lib" as bbc_lib {
        component "crt0.s" as crt0
        component "rom_detect.s" as rom_detect
        component "clib_stubs.s" as clib_stubs_lib
        component "rom_error.s" as rom_error

        folder "Local C Runtime" as local_runtime {
            component "zerobss / heap / printf / malloc / etc" as other_excluded
        }

        note right of crt0
            Startup Code:
            - ROM detection & paging
            - C runtime initialisation
            - Clean exit
        end note

        note right of rom_detect
            ROM Scanner:
            - Scans slots 0-15
            - Validates ROM type $82 "cc65 CLIB"
            - Stores original ROMSEL
            - Aborts with message if not found
        end note

        note right of clib_stubs_lib
            Function Stubs (~522):
            := <absolute ROM jump-slot address>
            Copied from cc65-clib build output
        end note

        note right of local_runtime
            Local Functions (~218):
            Need BSS/DATA/ONCE segments
            heap, stdio, errno, signals, etc.
        end note
    }

    bbc_clib_libsrc --> bbc_lib : "cc65 build"
}

package "Application Build" as app_build {
    artifact "C Source" as app_source
    artifact "Executable" as app_final
    note right of app_final
        ssd file on DFS disc
        Linked with bbc-clib.lib
        Calls ROM functions via stubs
    end note

    app_source --> app_final : "cl65 -t bbc-clib"
    bbc_lib --> app_final
}

package "Test Infrastructure" as test_infra {
    folder "Unit Tests (soft65c02)" as unit_tests {
        component "tests/unit/ (54 tests)" as unit_test_dir
        note right of unit_test_dir
            Pure 6502 emulator, no BBC HW.
            tests/harness/ provides MOS stubs
            (crt0, OSBYTE, OSWRCH mock, BRK trap).
            Each test: YAML config + DSL script + .s source.
        end note
    }

    folder "Integration Tests (beebium)" as int_tests {
        component "tests/integration/scripted/ (24 tests)" as int_test_dir
        note right of int_test_dir
            Full BBC Micro emulation via beebium.
            Dual-mode: each test runs for both
            bbc (RAM) and bbc-clib (ROM-split).
            Session-scoped beebium instances
            (one per mode) avoid launch-flakiness.
        end note

        component "tests/integration/discs/" as int_discs
        note right of int_discs
            C sources for disc-based test programs:
            TCONSL, TBREAK, TCLOCK, TOSFIL,
            TFDISK, TKBHIT, TSCREN, TDIR.
            Linked at $1900 (DFS PAGE) to avoid
            DFS workspace collision.
        end note
    }

    folder "Test Scripts (build-rom/)" as build_rom {
        component "build-rom/Makefile" as build_rom_make
        note right of build_rom_make
            Orchestrates end-to-end build:
            1. make -C src clean copy-cc65-artifacts
            2. cp clib.rom → roms/
            3. make -C cc65 libsrc TARGETS=bbc,bbc-clib
        end note
    }
}

' === Artifact flows ===
clib_stubs_generated -.-> clib_stubs_lib : "copied by copy-cc65-artifacts"
inc_objs -.-> bbc_clib_libsrc : "copied by copy-cc65-artifacts"
rom_file -.-> clib_stubs_generated : "linked from, used for address mapping"

' === Runtime ===
package "Runtime Environment" as runtime {
    component "BBC Micro" as bbc_micro {
        component "Sideways ROM Slot" as rom_slot
        component "Application Memory" as app_memory
        note right of rom_slot : $8000-$BFFF, paged by ROMSEL ($FE30)
        note right of app_memory : $1900+ (program + stubs + local functions)
    }
}

rom_file --> rom_slot
app_final --> app_memory : "loaded by *RUN"

' Execution Flow
crt0 --> rom_slot : "detect and page ROM"
rom_slot --> app_memory : "ROM functions accessible"
app_memory --> rom_slot : "calls via stubs → jump table"
local_runtime --> app_memory : "local functions in RAM"

' Styling
skinparam component {
    BackgroundColor lightblue
    BorderColor black
}

skinparam artifact {
    BackgroundColor lightgreen
    BorderColor black
}

skinparam package {
    BackgroundColor lightyellow
    BorderColor black
}

skinparam folder {
    BackgroundColor lightcyan
    BorderColor black
}

skinparam note {
    BackgroundColor wheat
    BorderColor brown
}

@enduml